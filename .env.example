# =============================================================================
# FormaOS — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control!
#
# Variables marked [PUBLIC] are exposed to the browser (NEXT_PUBLIC_*).
# Variables marked [SECRET] must NEVER be exposed client-side.
# =============================================================================

# =============================================================================
# SUPABASE  (required)
# =============================================================================
# Get all three from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co          # [PUBLIC] Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                               # [PUBLIC] anon/public key — safe for browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...                                   # [SECRET] bypasses RLS — server-only

# =============================================================================
# APPLICATION URLS  (required)
# =============================================================================
# Local dev: http://localhost:3000 — Production: set in Vercel to your real domains
NEXT_PUBLIC_APP_URL=http://localhost:3000                           # [PUBLIC] app domain (e.g. https://app.formaos.com.au)
NEXT_PUBLIC_SITE_URL=http://localhost:3000                          # [PUBLIC] marketing domain (e.g. https://www.formaos.com.au)
# NEXT_PUBLIC_COOKIE_DOMAIN=.formaos.com.au                        # [PUBLIC] optional — cookie domain for cross-subdomain auth (production only)

# =============================================================================
# FOUNDER / ADMIN ACCESS  (required)
# =============================================================================
# Grants admin panel access — use the email(s) you sign up with
FOUNDER_EMAILS=founder@example.com                                 # [SECRET] comma-separated list of admin emails
# FOUNDER_USER_IDS=uuid-1,uuid-2                                  # [SECRET] optional — Supabase user UUIDs for admin access
# FOUNDER_API_TOKEN=                                               # [SECRET] optional — bearer token for /api/health/detailed endpoint

# =============================================================================
# HEALTH ENDPOINT HARDENING  (recommended: always ON in production)
# =============================================================================
HEALTH_DETAILED_PROTECT=1                                          # [SECRET] 1=token-protected (default), 0=public (never in production)
HEALTH_DETAILED_FOUNDER_TOKEN=REPLACE_ME                           # [SECRET] required — random token for /api/health/detailed access
# HEALTH_DETAILED_INCLUDE_SYSTEM=0                                 # [SECRET] optional — set to 1 to include OS/memory info in health response

# =============================================================================
# STRIPE — BILLING  (required for billing)
# =============================================================================
# Get from Stripe Dashboard → Developers → API keys / Webhooks
# Use sk_test_* keys for development. Live keys only in Vercel.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME                               # [SECRET] Stripe secret API key
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME                             # [SECRET] Stripe webhook signing secret (Developers → Webhooks)
# STRIPE_REQUIRE_LIVEMODE_IN_PROD=true                              # Default: livemode is required when NODE_ENV=production. Set "false" to override for staging-on-prod-domain scenarios.
STRIPE_PRICE_FOUNDATION=price_REPLACE_ME                           # [SECRET] Foundation price ID (maps to internal basic)
STRIPE_PRICE_GROWTH=price_REPLACE_ME                               # [SECRET] Growth price ID (maps to internal pro)
STRIPE_PRICE_SCALE=price_REPLACE_ME                                # [SECRET] Scale price ID (maps to internal scale, $1,800/mo). Required in prod (scripts/check-env.js productionRequiredKeys). Without it the Scale tier checkout will fail at price-id resolution.
# STRIPE_PRICE_ENTERPRISE=price_REPLACE_ME                         # [SECRET] optional — Price ID for enterprise plan
# Stripe Payment Links are sales-only. Both Foundation and Growth links are sent manually by sales
# post-demo to buyers who already have a FormaOS account (so the webhook can provision via
# session.metadata.organization_id). Never expose these as NEXT_PUBLIC_* — anonymous Payment Link
# purchases will bypass provisioning. Public "Start Assessment" CTA always routes to /contact.
# STRIPE_PAYMENT_LINK_FOUNDATION=https://buy.stripe.com/REPLACE_ME # [SECRET] Foundation Payment Link (sales reference only)
# STRIPE_PAYMENT_LINK_GROWTH=https://buy.stripe.com/REPLACE_ME     # [SECRET] Growth Payment Link (sales reference only)
# Deprecated legacy names. Do not rely on these for active Foundation/Growth checkout.
# STRIPE_PRICE_BASIC=price_REPLACE_ME                              # [SECRET] deprecated — legacy alias for Foundation
# STRIPE_PRICE_PRO=price_REPLACE_ME                                # [SECRET] deprecated — legacy alias for Growth
# STRIPE_STARTER_PRICE_ID=price_REPLACE_ME                         # [SECRET] deprecated — legacy plan catalog alias for Foundation
# STRIPE_PRO_PRICE_ID=price_REPLACE_ME                             # [SECRET] deprecated — legacy plan catalog alias for Growth
# STRIPE_ENTERPRISE_PRICE_ID=price_REPLACE_ME                      # [SECRET] optional — overrides plan-level enterprise price
# BILLING_AUTO_FIX=true                                            # optional — defaults FALSE (detect-only). Set to "true" in prod to let the nightly cron auto-correct status/plan/period drift. Off-by-default guards against silent downgrades from transient Stripe 5xx (v4-025).

# =============================================================================
# RESEND — EMAIL  (required for transactional emails)
# =============================================================================
# Get from Resend Dashboard → API Keys
RESEND_API_KEY=re_REPLACE_ME                                       # [SECRET] Resend API key
RESEND_FROM_EMAIL=Formaos.team@gmail.com                           # [SECRET] sender "from" address for transactional emails
# RESEND_FROM_NAME=FormaOS                                         # [SECRET] optional — sender display name (default: "FormaOS")
# SUPPORT_EMAIL=Formaos.team@gmail.com                             # [SECRET] optional — support/contact inbox for auth emails
# NEXT_PUBLIC_CONTACT_EMAIL=Formaos.team@gmail.com                 # [PUBLIC] optional — marketing/footer contact address

# =============================================================================
# UPSTASH REDIS — RATE LIMITING / CACHING
# =============================================================================
# Production requires REST credentials for distributed auth/admin rate limits.
# Local/dev/E2E falls back to deterministic in-memory limits when absent.
# Get from Upstash Console → Redis → your database → REST API.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io            # [SECRET] required in production
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME                                # [SECRET] required in production
# REDIS_REQUIRED=true                                              # [SECRET] optional — force production-style Redis requirement outside production
# UPSTASH_REDIS_URL=rediss://default:password@host:6379            # [SECRET] optional — TCP URL for tools that need native Redis
# SECURITY_LOG_DB_TIMEOUT_MS=1500                                  # [SECRET] optional — audit/security DB write timeout, clamped 500-5000ms

# =============================================================================
# TRIGGER.DEV — BACKGROUND JOBS  (optional)
# =============================================================================
# Get from Trigger.dev Dashboard → Project Settings
# TRIGGER_PROJECT_REF=proj_yourproject                             # [SECRET] project reference ID
# TRIGGER_SECRET_KEY=tr_dev_REPLACE_ME                             # [SECRET] API secret key
# TRIGGER_API_URL=https://api.trigger.dev                          # [SECRET] optional — API endpoint override
# TRIGGER_APP_BASE_URL=https://app.formaos.com.au                  # [SECRET] optional — base URL for task callbacks
# TRIGGER_DEV_ENABLED=1                                            # [SECRET] optional — enable local Trigger execution in development
# TRIGGER_DISABLED=1                                               # [SECRET] optional — force Redis fallback even when Trigger is configured

# =============================================================================
# OPENTELEMETRY / TRACING  (optional)
# =============================================================================
# OTEL_SERVICE_NAME=formaos                                        # [SECRET] service name for traces
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint/v1/traces # [SECRET] OTLP collector endpoint
# Local Tracetest/OTel collector: http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>          # [SECRET] auth headers for OTLP exporter

# =============================================================================
# LANGFUSE — LLM OBSERVABILITY  (optional)
# =============================================================================
# Get from Langfuse Dashboard → Settings → API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME                             # [SECRET] Langfuse public key
# LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME                             # [SECRET] Langfuse secret key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com                     # [SECRET] optional — self-hosted Langfuse URL
# LANGFUSE_TRACING_ENVIRONMENT=development                         # [SECRET] optional — environment label for traces

# =============================================================================
# PAGERDUTY — ON-CALL PAGING  (optional; required for P0 SMS wake-up)
# =============================================================================
# Generated from: PagerDuty → Service → Integrations → "Events API v2".
# Without this, lib/observability/paging.ts no-ops (callers still warn-
# log so absence is visible). Wire into the on-call rotation in the
# PagerDuty UI; the integration key alone decides which service the
# incidents land on.
# PAGERDUTY_ROUTING_KEY=00000000000000000000000000000000             # [SECRET] PagerDuty integration key

# =============================================================================
# GOOGLE IDENTITY SERVICES  (required for Google OAuth branding)
# =============================================================================
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com  # [PUBLIC]

# =============================================================================
# SENTRY — ERROR MONITORING  (optional)
# =============================================================================
# Get DSN from Sentry Dashboard → Settings → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...                 # [PUBLIC] Sentry DSN — enables error tracking in production
# SENTRY_AUTH_TOKEN=sntrys_REPLACE_ME                              # [SECRET] required in production for release/source-map upload
# SENTRY_ORG=your-org-slug                                        # [SECRET] optional — Sentry org for source maps upload during build
# SENTRY_PROJECT=your-project-slug                                 # [SECRET] optional — Sentry project for source maps upload during build

# =============================================================================
# POSTHOG — PRODUCT ANALYTICS  (optional)
# =============================================================================
# Get from PostHog Dashboard → Project Settings
# NEXT_PUBLIC_POSTHOG_KEY=phc_...                                  # [PUBLIC] PostHog project API key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com                 # [PUBLIC] PostHog instance URL (or your self-hosted URL)
# NEXT_PUBLIC_ANALYTICS_ENABLED=true                               # [PUBLIC] optional — force-enable analytics outside production

# =============================================================================
# CRON / AUTOMATION  (optional)
# =============================================================================
# Generate a random secret; used to authenticate Vercel Cron or external cron calls
CRON_SECRET=REPLACE_ME                                             # [SECRET] bearer token for /api/cron/* endpoints (required in production)

# =============================================================================
# AI  (optional)
# =============================================================================
# Get from OpenAI Dashboard → API Keys
# OPENAI_API_KEY=sk-...                                            # [SECRET] enables AI compliance assistant features

# =============================================================================
# SECURITY / TOKENS  (optional)
# =============================================================================
# EXPORT_TOKEN_SECRET=REPLACE_ME                                   # [SECRET] optional — signing secret for export download tokens (falls back to JWT_SECRET)
# JWT_SECRET=REPLACE_ME                                            # [SECRET] optional — fallback signing secret if EXPORT_TOKEN_SECRET is not set

# =============================================================================
# REPORT EXPORTS  (optional)
# =============================================================================
# REPORT_EXPORTS_BUCKET=report-exports                             # [SECRET] optional — Supabase storage bucket name (default: "report-exports")
# REPORT_EXPORTS_INLINE_PROCESSING=true                            # [SECRET] optional — set to "false" to skip inline processing of exports

# =============================================================================
# NOTIFICATIONS  (optional)
# =============================================================================
# DEFAULT_TIMEZONE=UTC                                             # [SECRET] optional — fallback timezone for digest notifications (default: "UTC")

# =============================================================================
# LOGGING  (optional)
# =============================================================================
# LOG_LEVEL=info                                                   # [SECRET] optional — server log level: debug, info, warn, error (default: debug in dev, info in prod)

# =============================================================================
# BRANDING  (optional)
# =============================================================================
# BRAND_OVERRIDE_ALLOW=false                                       # [SECRET] optional — set to "true" to allow runtime brand config overrides

# =============================================================================
# APP METADATA  (optional, typically set by CI/Vercel)
# =============================================================================
# NEXT_PUBLIC_APP_VERSION=1.0.0                                    # [PUBLIC] optional — shown in analytics events (default: "unknown")

# =============================================================================
# SECRETS — added by audit-v4-022
# Production-required keys that previously weren't documented here. The
# values shown are placeholders; rotate before use.
# =============================================================================
# TOTP_ENCRYPTION_KEY=REPLACE_ME                                   # [SECRET] required in prod — 32-byte key for AES-256-GCM encryption of TOTP secrets (lib/security)
# INTEGRATION_CONFIG_KEY=REPLACE_ME                                # [SECRET] required in prod — AES-256-GCM key for directory_sync_configs.config + integration credentials. Prefer this over INTEGRATION_CONFIG_SECRET (legacy alias). NEVER reuse SUPABASE_SERVICE_ROLE_KEY for this purpose.
# INTEGRATION_CONFIG_SECRET=REPLACE_ME                             # [SECRET] legacy name for INTEGRATION_CONFIG_KEY — still honoured for back-compat. Rotate to INTEGRATION_CONFIG_KEY.
# TRUST_PACKET_SIGNING_KEY=REPLACE_ME                              # [SECRET] required in prod — Ed25519 signing key for trust packet exports
# EMAIL_UNSUBSCRIBE_SECRET=REPLACE_ME                              # [SECRET] required in prod — signs one-click unsubscribe tokens in outgoing emails
# Audit Sprint 6a (2026-05-23): STRIPE_PRICE_SCALE moved to the core
# STRIPE — BILLING block (uncommented) since Scale is now a sellable tier.
# SAML_SP_PRIVATE_KEY=REPLACE_ME                                   # [SECRET] required for SAML SSO — service-provider private key (PEM, base64)
# SAML_SP_PUBLIC_CERT=REPLACE_ME                                   # [SECRET] required for SAML SSO — service-provider public certificate (PEM, base64)
# VAPID_PRIVATE_KEY=REPLACE_ME                                     # [SECRET] required for push notifications — VAPID private key for web push
# FIREBASE_SERVER_KEY=REPLACE_ME                                   # [SECRET] required for mobile push — FCM server key for mobile notification delivery
# KV_REST_API_TOKEN=REPLACE_ME                                     # [SECRET] required when using Vercel KV — KV REST API token (rate-limit + cache backend)
# NEXTAUTH_SECRET=REPLACE_ME                                       # [SECRET] legacy back-compat fallback for INTEGRATION_CONFIG_KEY. Strongly prefer INTEGRATION_CONFIG_KEY for new environments.

# =============================================================================
# Org-retirement / data purge — Audit 2026-05-27
# =============================================================================
# ORG_RETIRE_GRACE_DAYS=90                                          # [PUBLIC] days between lifecycle_status='retired' and eligibility for hard delete. Default 90 if unset.
# ORG_PURGE_ENABLED=false                                           # [PUBLIC] hard switch for the /api/cron/process-org-purges processor. While 'false' (default), the daily cron picks no orgs — it logs that it skipped and exits. Flip to 'true' ONLY when a retired org is genuinely ready to be cascade-deleted; the operation is irreversible (Supabase PITR retains 7 days but recovery is a support ticket).

# =============================================================================
# Audit-chain hardening — Audit 2026-05-27 (R3 + R4 + external anchor)
# =============================================================================
# AUDIT_CHAIN_HMAC_KEY=REPLACE_ME                                   # [SECRET] required in prod when AUDIT_CHAIN_V3_ENABLED=true — wrapping key for the per-org HMAC keys stored in audit_chain_secrets. Use a separate value from INTEGRATION_CONFIG_KEY and SUPABASE_SERVICE_ROLE_KEY so a single credential leak can't both rewrite the chain and decrypt keys.
# AUDIT_CHAIN_V3_ENABLED=false                                      # [PUBLIC] when 'true', writeAuditLog routes new entries through audit_log_append_v3 (keyed-HMAC chain). Default off; flip after AUDIT_CHAIN_HMAC_KEY is provisioned. v1/v2 rows remain verifiable; verifier auto-selects per row.
# AUDIT_CHAIN_ANCHOR_ENABLED=false                                  # [PUBLIC] when 'true', /api/cron/audit-chain-anchor submits each org's latest top-of-chain hash to Sigstore Rekor daily. Default off. Network call is bounded (REKOR_TIMEOUT_MS=15s) and capped at MAX_ORGS_PER_TICK=50.
# AUDIT_CHAIN_ANCHOR_REKOR_URL=https://rekor.sigstore.dev           # [PUBLIC] Rekor API base. Override for testing against a private Rekor instance.
# AUDIT_CHAIN_ANCHOR_REKOR_VIEW_URL=https://search.sigstore.dev     # [PUBLIC] human-facing UI base for Rekor entry view URLs.
